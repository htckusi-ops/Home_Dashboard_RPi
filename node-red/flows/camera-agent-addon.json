[
  {
    "id": "cam_tab",
    "type": "tab",
    "label": "Camera Agent",
    "disabled": false,
    "info": "Presence detection and face recognition → display wake + adult session"
  },
  {
    "id": "cam_broker",
    "type": "mqtt-broker",
    "name": "Dashboard Broker",
    "broker": "localhost",
    "port": "1883",
    "clientid": "nodered_camera_agent",
    "autoConnect": true,
    "usetls": false,
    "protocolVersion": "4",
    "keepalive": "60",
    "cleansession": true,
    "birthTopic": "",
    "birthQos": "0",
    "birthPayload": "",
    "birthMsg": {},
    "closeTopic": "",
    "closeQos": "0",
    "closePayload": "",
    "closeMsg": {},
    "willTopic": "",
    "willQos": "0",
    "willPayload": "",
    "willMsg": {},
    "sessionExpiry": ""
  },
  {
    "id": "cam_presence_in",
    "type": "mqtt in",
    "z": "cam_tab",
    "name": "Presence State",
    "topic": "dashboard/panels/+/presence/state",
    "qos": "0",
    "datatype": "json",
    "broker": "cam_broker",
    "nl": false,
    "rap": false,
    "rh": 0,
    "inputs": 0,
    "x": 160,
    "y": 80,
    "wires": [["fn_presence_wake"]]
  },
  {
    "id": "fn_presence_wake",
    "type": "function",
    "z": "cam_tab",
    "name": "Wake display on presence",
    "func": "var parts = msg.topic.split('/');\nvar panelId = parts[2];\n\nif (!msg.payload || msg.payload.detected !== true) {\n    return null;\n}\n\nmsg.topic = 'dashboard/panels/' + panelId + '/display/set';\nmsg.payload = 'on';\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 400,
    "y": 80,
    "wires": [["cam_presence_out"]]
  },
  {
    "id": "cam_presence_out",
    "type": "mqtt out",
    "z": "cam_tab",
    "name": "Display Set",
    "topic": "",
    "qos": "0",
    "retain": "false",
    "respTopic": "",
    "contentType": "",
    "userProps": "",
    "correl": "",
    "expiry": "",
    "broker": "cam_broker",
    "x": 650,
    "y": 80,
    "wires": []
  },
  {
    "id": "cam_face_in",
    "type": "mqtt in",
    "z": "cam_tab",
    "name": "Face Recognized",
    "topic": "dashboard/panels/+/face/recognized",
    "qos": "0",
    "datatype": "json",
    "broker": "cam_broker",
    "nl": false,
    "rap": false,
    "rh": 0,
    "inputs": 0,
    "x": 160,
    "y": 200,
    "wires": [["fn_face_adult"]]
  },
  {
    "id": "fn_face_adult",
    "type": "function",
    "z": "cam_tab",
    "name": "Adult session on face",
    "func": "var parts = msg.topic.split('/');\nvar panelId = parts[2];\n\nif (!msg.payload || msg.payload.adult !== true) {\n    return null;\n}\n\nvar cfg = { adult_session_seconds: 300 };\nvar expiresAt = new Date(Date.now() + cfg.adult_session_seconds * 1000).toISOString();\n\nmsg.topic = 'dashboard/panels/' + panelId + '/pin/result';\nmsg.payload = {\n    success: true,\n    mode: 'adult',\n    expires_at: expiresAt,\n    recognized_as: msg.payload.person\n};\nmsg.retain = false;\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 400,
    "y": 200,
    "wires": [["cam_face_out"]]
  },
  {
    "id": "cam_face_out",
    "type": "mqtt out",
    "z": "cam_tab",
    "name": "Pin Result",
    "topic": "",
    "qos": "0",
    "retain": "false",
    "respTopic": "",
    "contentType": "",
    "userProps": "",
    "correl": "",
    "expiry": "",
    "broker": "cam_broker",
    "x": 650,
    "y": 200,
    "wires": []
  }
]
