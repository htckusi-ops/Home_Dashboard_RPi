{
  "panel_id": "kitchen",
  "panel_name": "Küche",
  "network": {
    "listen": "0.0.0.0",
    "profile": "eth-wan",
    "wan_iface": "eth0",
    "ap_iface": "wlan0",
    "vpn_iface": "tun0",
    "wifi_ap": {
      "ssid": "Dashboard-AP",
      "password": "",
      "channel": 6,
      "gateway": "192.168.50.1",
      "dhcp_from": "192.168.50.100",
      "dhcp_to": "192.168.50.200"
    },
    "lan": {
      "iface": "eth1",
      "gateway": "172.16.100.1",
      "dhcp_from": "172.16.100.100",
      "dhcp_to": "172.16.100.200"
    }
  },
  "mqtt": {
    "broker": "ws://homeserver.local:9001",
    "clientId": "dashboard_kitchen"
  },
  "display": {
    "timeout_seconds": 180,
    "default_blanking_suppression_seconds": 14400,
    "blanking_step_minutes": 30
  },
  "adult": {
    "pin": "1234",
    "session_timeout_seconds": 300
  },
  "cameras": {
    "entrance": {
      "url": "http://zoneminder.local/zm/index.php?view=live&mid=1",
      "name": "Eingang",
      "icon": "🚪",
      "tap_seconds": 30,
      "hold_seconds": 0
    }
  },
  "embeds": {
    "grafana": {
      "url": "http://grafana.local:3000/d/home",
      "name": "Grafana"
    },
    "homeassistant": {
      "url": "http://homeassistant.local:8123",
      "name": "Home Assistant"
    }
  },
  "scenes": [
    { "id": "yoga",        "name": "Yoga",        "icon": "🧘",  "color": "#6366f1" },
    { "id": "kinderparty", "name": "Kinderparty", "icon": "🎉",  "color": "#f59e0b" },
    { "id": "abendessen",  "name": "Abendessen",  "icon": "🍽️", "color": "#ef4444" },
    { "id": "nachtmodus",  "name": "Nachtmodus",  "icon": "🌙",  "color": "#1e293b" }
  ],
  "sonos": {
    "playlists": [
      { "id": "kids_songs",   "name": "Kinderlieder", "icon": "🎵" },
      { "id": "radio_energy", "name": "Energy Radio", "icon": "📻" },
      { "id": "classical",    "name": "Klassik",      "icon": "🎻" }
    ],
    "kids_max_volume": 50
  },
  "weather": {
    "enabled": true,
    "location": "Zürich",
    "country": "CH"
  },
  "lights": [
    { "id": "licht_garten",   "name": "Licht Garten",   "icon": "💡", "color": "#f59e0b" },
    { "id": "licht_terrasse", "name": "Licht Terrasse", "icon": "💡", "color": "#f59e0b" },
    { "id": "licht_brunnen",  "name": "Licht Brunnen",  "icon": "🫧", "color": "#3b82f6" }
  ],
  "appliances": [
    {
      "id": "tumbler",
      "name": "Tumbler",
      "icon": "🌀",
      "power_topic": "home/power/tumbler_w",
      "notify_done": true
    },
    {
      "id": "waschmaschine",
      "name": "Waschmaschine",
      "icon": "👕",
      "power_topic": null,
      "notify_done": true
    },
    {
      "id": "ventilator_waschkueche",
      "name": "Lüfter Waschküche",
      "icon": "💨",
      "type": "ventilator",
      "manual_timer_seconds": 7200
    }
  ],
  "sensors": {
    "ticker": {
      "enabled": true,
      "interval_seconds": 5
    },
    "groups": {
      "indoor": {
        "label": "Innen",
        "sensors": {
          "temp_wohnzimmer": {
            "label": "Wohnzimmer",
            "topic": "zigbee2mqtt/sensor_wohnzimmer/temperature",
            "unit": "°C",
            "decimals": 1,
            "stale_minutes": 15,
            "ticker": true
          },
          "temp_kueche": {
            "label": "Küche",
            "topic": "zigbee2mqtt/sensor_kueche/temperature",
            "unit": "°C",
            "decimals": 1,
            "stale_minutes": 15,
            "ticker": true
          },
          "humidity_wohnzimmer": {
            "label": "Feuchte WZ",
            "topic": "zigbee2mqtt/sensor_wohnzimmer/humidity",
            "unit": "%",
            "decimals": 0,
            "stale_minutes": 15
          }
        }
      },
      "outdoor": {
        "label": "Aussen",
        "sensors": {
          "temp_aussen": {
            "label": "Aussen",
            "topic": "zigbee2mqtt/sensor_aussen/temperature",
            "unit": "°C",
            "decimals": 1,
            "stale_minutes": 30,
            "ticker": true
          },
          "humidity_aussen": {
            "label": "Feuchte Aussen",
            "topic": "zigbee2mqtt/sensor_aussen/humidity",
            "unit": "%",
            "decimals": 0,
            "stale_minutes": 30
          }
        }
      },
      "energy": {
        "label": "Energie",
        "grafana_url": "http://grafana.local:3000/d/energy",
        "sensors": {
          "solar_aktuell": {
            "label": "Solar aktuell",
            "topic": "home/solar/power_w",
            "unit": "kW",
            "factor": 0.001,
            "decimals": 2,
            "stale_minutes": 5,
            "ticker": true
          },
          "solar_tag": {
            "label": "Solar heute",
            "topic": "home/solar/energy_today_wh",
            "unit": "kWh",
            "factor": 0.001,
            "decimals": 1,
            "stale_minutes": 60,
            "grafana_url": "http://grafana.local:3000/d/solar"
          },
          "verbrauch_haus": {
            "label": "Verbrauch",
            "topic": "home/power/total_w",
            "unit": "kW",
            "factor": 0.001,
            "decimals": 2,
            "stale_minutes": 5
          },
          "waermepumpe": {
            "label": "Wärmepumpe",
            "topic": "home/power/heatpump_w",
            "unit": "kW",
            "factor": 0.001,
            "decimals": 2,
            "stale_minutes": 5
          }
        }
      },
      "waschkueche": {
        "label": "Waschküche",
        "sensors": {
          "temp_waschkueche": {
            "label": "Temperatur",
            "topic": "zigbee2mqtt/sensor_waschkueche/temperature",
            "unit": "°C",
            "decimals": 1,
            "stale_minutes": 15
          },
          "humidity_waschkueche": {
            "label": "Feuchte WK",
            "topic": "zigbee2mqtt/sensor_waschkueche/humidity",
            "unit": "%",
            "decimals": 0,
            "stale_minutes": 15,
            "ticker": true
          }
        }
      }
    }
  },
  "calendars": {
    "sources": {
      "google_family": {
        "name": "Familie",
        "color": "#4285F4"
      },
      "nextcloud_work": {
        "name": "Arbeit",
        "color": "#0082C9"
      },
      "office365_shared": {
        "name": "Firma",
        "color": "#D83B01"
      }
    },
    "profiles": [
      {
        "id": "alles",
        "name": "Alles",
        "sources": ["google_family", "nextcloud_work", "office365_shared"]
      },
      {
        "id": "privat",
        "name": "Privat",
        "sources": ["google_family"]
      },
      {
        "id": "arbeit",
        "name": "Arbeit",
        "sources": ["nextcloud_work", "office365_shared"]
      }
    ],
    "lookahead_days": 7
  }
}
