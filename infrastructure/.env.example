# Zentraler Server — Umgebungsvariablen für infrastructure/docker-compose.yml
# Datei kopieren: cp .env.example .env  und dann anpassen.
# .env wird NICHT ins Repository eingecheckt.

# Node-RED: Panel-PINs (pro Panel eine Variable)
NR_KITCHEN_PIN=1234
NR_LIVINGROOM_PIN=1234

# Node-RED: Credential-Verschlüsselung (zufälligen Wert setzen)
NR_CREDENTIAL_SECRET=change-me-in-production

# Node-RED: Admin-Passwort (für Node-RED UI Absicherung)
NR_ADMIN_PASSWORD=

# Home Assistant Integration
HA_URL=http://homeassistant.local:8123
HA_TOKEN=

# Sonos HTTP API
SONOS_API_URL=http://sonos-api.local:5005
